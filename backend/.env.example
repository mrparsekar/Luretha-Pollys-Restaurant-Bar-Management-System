# ---------------------------------------------------------------------------
# Copy to .env and fill in. Defaults below are enough to run locally:
# with DATABASE_URL empty the API uses an embedded Postgres (PGlite) in .data/
# ---------------------------------------------------------------------------

PORT=4001
NODE_ENV=development

# Signs the session cookie. MUST be a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Empty = embedded Postgres in ./.data/pg (no install needed).
# Production: Supabase session-pooler URL, e.g.
# postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Browser origins allowed to call this API with cookies. Use a comma-separated
# list when local and deployed frontend origins both need access.
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend, used to build the bill link sent on WhatsApp/email.
PUBLIC_APP_URL=http://localhost:5173

# Set to true when the frontend and API are on different domains, such as a
# Vercel frontend calling a Vercel backend. HTTPS is required for this mode.
COOKIE_CROSS_SITE=false

# Outgoing mail. Brevo (smtp-relay.brevo.com:587) or Gmail + app password
# (smtp.gmail.com:587) both work without owning a domain.
# Leave SMTP_HOST empty to disable email; WhatsApp and the bill link still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Luretha & Pollys <no-reply@example.com>

# Accounts created by `npm run db:seed`. Change the password after first login.
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@lurethaandpollys.local
SEED_OWNER_PASSWORD=changeme123
SEED_WAITER_NAME=Waiter One
SEED_WAITER_PIN=1234
