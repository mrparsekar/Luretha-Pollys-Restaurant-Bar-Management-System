# ---------------------------------------------------------------------------
# Copy to .env and adjust. The defaults match a backend started with its own
# .env.example, so `npm run dev` in both folders just works.
# ---------------------------------------------------------------------------

# Where the Vite dev server forwards /api. Only used in development; in
# production the API is served from the same domain as this app.
API_PROXY_TARGET=http://localhost:4001

# Base path for API calls from the browser. Keep /api locally to use the Vite
# proxy. In the Vercel frontend, set this to the deployed backend URL plus /api.
# Example: https://your-backend.vercel.app/api
VITE_API_BASE=/api

# Shown on the login screen before the API has answered.
VITE_APP_NAME=Luretha & Pollys
